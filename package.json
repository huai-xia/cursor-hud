{
  "name": "cursor-hud",
  "version": "0.1.0",
  "description": "Real-time statusline HUD for Cursor CLI — model, git, context, plan usage, tools & subagents",
  "type": "module",
  "bin": {
    "cursor-hud": "./dist/index.js"
  },
  "main": "./dist/index.js",
  "files": [
    "dist/",
    "scripts/",
    "README.md"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "start": "node dist/index.js",
    "test:stdin": "npm run build && node dist/index.js < fixtures/sample-stdin.json",
    "setup": "node scripts/setup.mjs",
    "setup:hooks": "node scripts/setup-hooks.mjs",
    "setup:hooks-probe": "node scripts/setup-hooks-probe.mjs",
    "uninstall:hooks": "node scripts/uninstall-hooks.mjs",
    "uninstall:hooks-probe": "node scripts/uninstall-hooks-probe.mjs",
    "test:hooks-merge": "npm run build && node scripts/test-hooks-merge.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/huai-xia/cursor-hud.git"
  },
  "bugs": {
    "url": "https://github.com/huai-xia/cursor-hud/issues"
  },
  "homepage": "https://github.com/huai-xia/cursor-hud#readme",
  "keywords": [
    "cursor",
    "cursor-cli",
    "statusline",
    "hud"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "typescript": "^5.8.0"
  }
}
